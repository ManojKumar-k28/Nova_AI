SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_KEY=your_anon_key
JWT_SECRET=nova_ai_secret_key_minimum_32_chars
JWT_EXPIRE_HOURS=72

# Groq LLM (free) — https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_DEFAULT_MODEL=llama-3.3-70b

# HuggingFace Embeddings (optional, free) — https://huggingface.co/settings/tokens
# If not set, RAG still works with a hash fallback
HUGGINGFACE_API_KEY=

# Vector store
VECTOR_DB_PATH=./vectorstore/nova
CHROMA_HOST=api.trychroma.com
CHROMA_API_KEY=your_chroma_key
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=nova

# App
WHISPER_MODEL=base
APP_NAME=Nova AI
APP_VERSION=1.0.0
DEBUG=True
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
